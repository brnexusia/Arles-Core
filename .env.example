NODE_ENV=production
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://arles:CHANGE_ME@postgres:5432/arles
REDIS_URL=redis://redis:6379

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

EVOLUTION_BASE_URL=https://SEU-EVOLUTION
EVOLUTION_API_KEY=
EVOLUTION_SEND_TEXT_PATH=/message/sendText/{instance}
EVOLUTION_SEND_MEDIA_PATH=/message/sendMedia/{instance}
EVOLUTION_MEDIA_BASE64_PATH=/chat/getBase64FromMediaMessage/{instance}

# Origens de browser permitidas no Core, separadas por vírgula. As origens Arles
# oficiais já possuem allowlist padrão; use esta variável apenas para acrescentar outras.
CORS_ALLOWED_ORIGINS=

# Arles Beauty. O modelo da vertical é fixado em gpt-5-nano no código.
BEAUTY_MONTHLY_PRICE_CENTS=4990

# Opcional. Enquanto vazio, o Beauty usa a Evolution atual sem migrar nenhuma sessão.
# Ao escalar, informe um JSON server-side; nunca exponha as apiKey no frontend.
BEAUTY_EVOLUTION_CLUSTERS=

# Asaas Pix Automático do Beauty. ASAAS_WEBHOOK_TOKEN é um token próprio do webhook,
# diferente da API key, enviado pelo Asaas no header asaas-access-token.
ASAAS_API_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Durante uma rotação, coloque aqui o token antigo. Remova após o Asaas usar o novo.
ASAAS_WEBHOOK_TOKEN_PREVIOUS=

# Meta Conversions API.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v26.0

# Arles Cash usa a instância que JÁ está conectada ao número oficial da Arles.
CASH_EVOLUTION_INSTANCE=nome-da-instancia-ja-conectada
CASH_OFFICIAL_NUMBER=5575999622157
CASH_MESSAGE_SILENCE_MS=250
CASH_MESSAGE_BUFFER_MS=15000

CASH_PAYMENT_MONTHLY_URL=https://pay.cakto.com.br/y2bhspu_1043142
CASH_PAYMENT_QUARTERLY_URL=https://pay.cakto.com.br/gh5iq23_1043146
CASH_PAYMENT_ANNUAL_URL=https://pay.cakto.com.br/uw7bctc_1043148
CASH_PAYMENT_PUBLIC_BASE_URL=https://pay.arlesglobal.com.br
CASH_PAYMENT_WEBHOOK_SECRET=TROQUE_POR_UMA_CHAVE_FORTE
CASH_SIGNUP_URL=

PUBLIC_BASE_URL=https://SEU-ENGINE
INTERNAL_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE
# Janela de rotação: mantenha a chave antiga somente enquanto os consumidores
# (Netlify/apps) são migrados para INTERNAL_API_KEY. Depois apague a anterior.
INTERNAL_API_KEY_PREVIOUS=
# Recomendado. Se vazio, usa INTERNAL_API_KEY como fallback.
AUTH_SESSION_SECRET=
AUTH_SESSION_DAYS=30

MESSAGE_BUFFER_MS=350
MESSAGE_LOCK_MS=15000
HUMAN_PAUSE_SECONDS=3600
FOLLOWUP_DELAY_SECONDS=1800
FOLLOWUP_WORKER_INTERVAL_MS=15000
JOB_WORKER_INTERVAL_MS=5000

DELIVERY_RECENT_CONFIRMED_TTL_SECONDS=86400
DELIVERY_REVIEW_TTL_SECONDS=604800
DELIVERY_PIX_PROOF_MAX_AGE_HOURS=8
