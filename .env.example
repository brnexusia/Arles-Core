NODE_ENV=production
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://arles:CHANGE_ME@postgres:5432/arles
REDIS_URL=redis://redis:6379

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

EVOLUTION_BASE_URL=https://SEU-EVOLUTION
EVOLUTION_API_KEY=
EVOLUTION_SEND_TEXT_PATH=/message/sendText/{instance}
EVOLUTION_SEND_MEDIA_PATH=/message/sendMedia/{instance}
EVOLUTION_MEDIA_BASE64_PATH=/chat/getBase64FromMediaMessage/{instance}

# Arles Cash usa a instância que JÁ está conectada ao número oficial da Arles.
# O cliente não cria instância e não usa QR Code. A conta é identificada pelo remetente.
CASH_EVOLUTION_INSTANCE=nome-da-instancia-ja-conectada
CASH_OFFICIAL_NUMBER=5571999999999

# Links externos dos três planos (Kirvano, Hotmart ou outro checkout).
CASH_PAYMENT_MONTHLY_URL=https://checkout.exemplo/mensal
CASH_PAYMENT_SEMIANNUAL_URL=https://checkout.exemplo/semestral
CASH_PAYMENT_ANNUAL_URL=https://checkout.exemplo/anual

# Segredo para POST /webhooks/cash/payment.
# Envie via Authorization: Bearer <segredo> ou X-Cash-Webhook-Secret.
CASH_PAYMENT_WEBHOOK_SECRET=TROQUE_POR_UMA_CHAVE_FORTE

# Legado/compatibilidade. O onboarding novo não depende de cadastro web.
CASH_SIGNUP_URL=

PUBLIC_BASE_URL=https://SEU-ENGINE
INTERNAL_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE
# Recomendado na v1.5.5. Se vazio, usa INTERNAL_API_KEY como fallback.
AUTH_SESSION_SECRET=
AUTH_SESSION_DAYS=30

MESSAGE_BUFFER_MS=350
MESSAGE_LOCK_MS=15000
HUMAN_PAUSE_SECONDS=3600
FOLLOWUP_DELAY_SECONDS=1800
FOLLOWUP_WORKER_INTERVAL_MS=15000
JOB_WORKER_INTERVAL_MS=5000

# Configuracoes exclusivas da vertical Delivery.
DELIVERY_RECENT_CONFIRMED_TTL_SECONDS=86400
DELIVERY_REVIEW_TTL_SECONDS=604800
DELIVERY_PIX_PROOF_MAX_AGE_HOURS=8
