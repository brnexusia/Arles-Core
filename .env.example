NODE_ENV=production
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://arles:CHANGE_ME@postgres:5432/arles
REDIS_URL=redis://redis:6379

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Evolution Go: global key is only used to create instances.
# Requests for a connected shop use its private per-instance token in PostgreSQL.
EVOLUTION_BASE_URL=https://SEU-EVOLUTION-GO
EVOLUTION_API_KEY=
# Generate a separate random secret and keep it out of the browser or Git.
EVOLUTION_WEBHOOK_SECRET=

PUBLIC_BASE_URL=https://pay.arlesglobal.com.br

# Segredo compartilhado para validar o webhook da Cakto.
CASH_PAYMENT_WEBHOOK_SECRET=TROQUE_POR_UMA_CHAVE_FORTE

# Legado/compatibilidade. O onboarding novo não depende de cadastro web.
CASH_SIGNUP_URL=

PUBLIC_BASE_URL=https://SEU-ENGINE
INTERNAL_API_KEY=TROQUE_POR_UMA_CHAVE_FORTE
# Recomendado na v1.5.5. Se vazio, usa INTERNAL_API_KEY como fallback.
AUTH_SESSION_SECRET=
AUTH_SESSION_DAYS=30

# Buffer de mensagens do Arles Delivery.
MESSAGE_BUFFER_MS=350
MESSAGE_LOCK_MS=15000
HUMAN_PAUSE_SECONDS=3600
FOLLOWUP_DELAY_SECONDS=1800
FOLLOWUP_WORKER_INTERVAL_MS=15000
JOB_WORKER_INTERVAL_MS=5000

# Configuracoes exclusivas da vertical Delivery.
DELIVERY_RECENT_CONFIRMED_TTL_SECONDS=86400
DELIVERY_REVIEW_TTL_SECONDS=604800
DELIVERY_PIX_PROOF_MAX_AGE_HOURS=8
